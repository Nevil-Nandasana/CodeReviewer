{
  "name": "codereview-ai",
  "displayName": "CodeReviewer — AI Code Review & Security",
  "description": "AI-powered local code review — no data leaves your machine",
  "version": "1.0.0",
  "publisher": "nevil-nandasana",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Linters"],
  "activationEvents": ["onLanguage:python", "onLanguage:javascript", "onLanguage:typescript", "onLanguage:java"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "codereview-ai.reviewFile", "title": "CodeReview AI: Review Current File" },
      { "command": "codereview-ai.clearDecorations", "title": "CodeReview AI: Clear Decorations" }
    ],
    "configuration": {
      "title": "CodeReview AI",
      "properties": {
        "codereview-ai.apiUrl": { "type": "string", "default": "http://localhost:8000", "description": "CodeReviewer API URL" },
        "codereview-ai.apiToken": { "type": "string", "default": "", "description": "JWT token from CodeReviewer dashboard" }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "dependencies": { "axios": "^1.7.2" },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.5",
    "esbuild": "^0.21.5",
    "@vscode/vsce": "^2.29.0"
  }
}
