# CodeReviewer configuration.
#
# Every key here corresponds to a field on `Settings` in backend/app/config.py.
# Keys that do not are silently discarded (the model sets extra="ignore"), so
# the two files are kept deliberately in sync — a setting you invent here has no
# effect. `python -m app.config` prints any mismatch.
#
#   cp .env.example backend/.env

# ── Environment ────────────────────────────────────────────────────────────────
# development | staging | production
# In production the app does NOT create tables at startup; Alembic owns the
# schema. Run `alembic upgrade head` before booting.
ENVIRONMENT=development
DEBUG=true

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://cruser:crpassword@localhost:5433/codereviewai

# ── Redis ──────────────────────────────────────────────────────────────────────
# Also backs the sliding-window rate limiter. Without it the limiter falls back
# to a per-process counter, which does not hold across multiple workers.
REDIS_URL=redis://localhost:6379/0

# ── Auth ───────────────────────────────────────────────────────────────────────
# Generate a real one — do not ship the default:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE-ME-generate-with-secrets.token_urlsafe-48
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── GitHub App ─────────────────────────────────────────────────────────────────
# Create at: https://github.com/settings/apps/new
# Webhook URL is /api/v1/webhook/github  (note the /github suffix)
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY_PATH=./github_private_key.pem
GITHUB_WEBHOOK_SECRET=your-webhook-secret-min-20-chars
GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx
GITHUB_CLIENT_SECRET=your-github-oauth-secret

# ── Model Backend ──────────────────────────────────────────────────────────────
# local  — run a local transformers model; nothing leaves the machine
# openai — call the OpenAI API; the diff is sent to a third party
MODEL_BACKEND=local
LOCAL_MODEL_PATH=./training/checkpoints/qwen1.5b-sft-v2-cleansplit/final_adapter
MODEL_MAX_NEW_TOKENS=1024
MODEL_TEMPERATURE=0.1

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Review Pipeline ────────────────────────────────────────────────────────────
# Both limits are enforced in review_pipeline/pipeline.py. A diff over the size
# limit is skipped outright rather than truncated.
MAX_DIFF_SIZE_KB=500
MAX_FILES_PER_PR=50
SUPPORTED_LANGUAGES=python,javascript,typescript,java,go
REVIEW_CACHE_TTL=3600

# ── Celery ─────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
