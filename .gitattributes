# Normalize all text files to LF in the repository
* text=auto eol=lf

# Explicitly declare binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.woff2 binary
*.woff binary
*.ttf binary
*.eot binary

# Python
*.py text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.env text eol=lf

# JavaScript / TypeScript / Frontend
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf

# Docker
Dockerfile text eol=lf
*.dockerfile text eol=lf

# Shell scripts
*.sh text eol=lf
Makefile text eol=lf
