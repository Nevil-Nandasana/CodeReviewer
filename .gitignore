build/

# Model files (too large for git — use git-lfs or separate storage)
models/
!/backend/app/models/
training/checkpoints/
training/data/train.jsonl
training/data/val.jsonl
training/data/test.jsonl
training/data/train_small.jsonl
training/*.log

# Evaluation artefacts.
# results/*.jsonl and report.md ARE committed — they are the evidence behind the
# numbers in the README, and `evaluation.score` can regenerate the report from
# them without re-running a model. Only the raw run logs are excluded.
evaluation/*.log
evaluation/results_dev/

